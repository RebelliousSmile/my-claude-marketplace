{
  "$schema": "design/references/contract-schema#components",
  "components": {
    "btn": {
      "base": "btn",
      "elements": {
        "icon": "btn__icon",
        "label": "btn__label"
      },
      "modifiers": {
        "primary": "btn--primary"
      },
      "backgrounds": [
        "color.semantic.background",
        "color.semantic.surface"
      ],
      "a11y": {
        "role": "button",
        "requires": []
      }
    },
    "card": {
      "base": "card",
      "elements": {
        "media": "card__media",
        "body": "card__body",
        "title": "card__title"
      },
      "modifiers": {
        "featured": "card--featured"
      },
      "backgrounds": [
        "color.semantic.surface"
      ],
      "a11y": {
        "role": "article",
        "requires": [
          "aria-label"
        ]
      }
    }
  }
}
