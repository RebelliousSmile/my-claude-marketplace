{
  "_doc": "Example measure.py config — a starting point, not a working setup. Replace the two local addresses, the selectors and the targets with your own. 'reference' is the mockup that decides; 'implementation' is what is measured against it. Generate a real one from a contract with config-gen.py; run it with measure.py --config <this> --ledger-registry <deviations.json>.",
  "reference_url": "http://localhost:8080",
  "reference_page": null,
  "implementation_url": "http://localhost:8888",
  "breakpoints": [
    { "name": "mobile", "width": 375, "height": 812, "mockup_viewport": "mobile" },
    { "name": "desktop", "width": 1440, "height": 900, "mockup_viewport": "desktop" }
  ],
  "props": ["fontSize", "fontWeight", "lineHeight", "color"],
  "targets": [
    { "name": "Header · title", "mockup": ".header__title", "implementation": ".header__title", "check_text": true },
    { "name": "Header · lede", "mockup": ".header__lede", "implementation": ".header__lede" },
    { "name": "Header · layout", "mockup": ".header", "implementation": ".header", "props": ["display", "gridTemplateColumns", "gap"] }
  ],
  "headings_sel": { "mockup": "h1, h2, h3", "implementation": "h1, h2, h3" },
  "ownership": {
    "surfaces": [
      { "name": "front", "url": "http://localhost:8888" },
      {
        "name": "editor",
        "url": "http://localhost:8888/wp-admin/site-editor.php",
        "frame_selector": "iframe[name=editor-canvas]",
        "requires_auth": true,
        "storage_state_env": "WP_EDITOR_STORAGE_STATE",
        "auth_hook_env": "WP_EDITOR_AUTH_HOOK"
      }
    ],
    "targets": [
      {
        "name": "Header · title",
        "selector": ".header__title",
        "class": "header__title",
        "prop": "color",
        "sources": ["header.css", "fse-bindings.css"]
      }
    ]
  }
}
