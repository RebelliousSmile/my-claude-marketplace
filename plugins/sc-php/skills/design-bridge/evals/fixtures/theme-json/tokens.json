{
  "color": {
    "brand": { "primary": { "$type": "color", "$value": "#2563eb" } },
    "semantic": { "background": { "$type": "color", "$value": "{color.brand.primary}" } }
  },
  "font": {
    "size": { "body": { "$type": "dimension", "$value": "1rem" } }
  },
  "space": {
    "4": { "$type": "dimension", "$value": "1rem" },
    "8": { "$type": "dimension", "$value": "2rem" }
  },
  "themes": {
    "dark": {
      "color": {
        "brand": { "primary": { "$value": "#93c5fd" } },
        "semantic": { "background": { "$value": "{color.brand.primary}" } }
      }
    }
  }
}
